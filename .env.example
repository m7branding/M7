# ============================================================
# M7 website — environment variables
# Kopieer naar .env.local (lokaal) of zet ze in Vercel → Settings → Environment Variables.
# ============================================================

# Publieke URL van de site (canonical, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://m7branding.com

# Google Analytics 4 — gebruik HETZELFDE measurement ID als de huidige site (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Optioneel: Google Tag Manager container (GTM-XXXXXXX). Gebruik GA4 óf GTM, niet allebei voor dezelfde tags.
NEXT_PUBLIC_GTM_ID=

# Search Console: alleen de content-waarde van de <meta name="google-site-verification"> tag
# (of verifieer via DNS — dan kan dit leeg blijven)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# AnswerLink / kennisbank
NEXT_PUBLIC_ANSWERS_URL=https://answers.m7branding.com
# Optioneel: embed-script van AnswerLink (widget of tracking), wordt lazy geladen
NEXT_PUBLIC_ANSWERLINK_SCRIPT=

# De configurator (zelfde repo, route /letsgo, ook bereikbaar via letsgo.m7branding.com)
NEXT_PUBLIC_LETSGO_URL=https://letsgo.m7branding.com

# Bedrijfsgegevens (worden ook in JSON-LD gebruikt)
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_KVK=

# Formulieren → webhook (Make / n8n / Zapier / Odoo). Server-side, niet publiek.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# Concept-reviews ook in productie tonen (alleen voor previews!)
NEXT_PUBLIC_SHOW_DRAFTS=
