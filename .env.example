# ============================================================
# M7 website — environment variables
# Kopieer naar .env.local (lokaal) of zet ze in Vercel → Settings → Environment Variables.
# ============================================================

# Publieke URL van de site (canonical, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://m7branding.com

# Google Analytics 4 — gebruik HETZELFDE measurement ID als de huidige site (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# (leeg = G-8P2VX3Z6NE, de property van de vorige site; zie src/content/site.ts)
# Optioneel: Google Tag Manager container (GTM-XXXXXXX). Gebruik GA4 óf GTM, niet allebei voor dezelfde tags.
NEXT_PUBLIC_GTM_ID=

# Search Console: alleen de content-waarde van de <meta name="google-site-verification"> tag
# (of verifieer via DNS — dan kan dit leeg blijven)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# AnswerLink / kennisbank
NEXT_PUBLIC_ANSWERS_URL=https://answers.m7branding.com
# Optioneel: embed-script van AnswerLink (widget of tracking), wordt lazy geladen
NEXT_PUBLIC_ANSWERLINK_SCRIPT=

# De configurator (zelfde repo, route /letsgo, ook bereikbaar via letsgo.m7branding.com)
NEXT_PUBLIC_LETSGO_URL=https://letsgo.m7branding.com

# Bedrijfsgegevens (worden ook in JSON-LD gebruikt)
# Telefoon van Martijn (belknoppen in support en intake), bv. +31 6 12345678
NEXT_PUBLIC_PHONE=
# (leeg = +31 6 57564847)
# WhatsApp internationaal zonder + of spaties (zwevende knop, intake, support).
# Standaard staat Martijns nummer (31657564847) in src/content/site.ts; alleen invullen om te overschrijven.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_KVK=
# (leeg = 81122721)
# BTW-identificatienummer, verplicht op de site naast de KvK (bv. NL123456789B01)
NEXT_PUBLIC_VAT=
# (leeg = NL861941342B01)
# YouTube-kanaal (leeg = nergens getoond)
NEXT_PUBLIC_YOUTUBE_URL=

# ------------------------------------------------------------
# E-mail via je eigen mailserver (SMTP), aanbevolen: leads, bevestigingen, supporttickets en de
# bevestigingsmail van de nieuwsbrief gaan dan via hello@m7branding.com op de mailserver van Zxcs/Vimexx.
# Zet deze in Vercel → Settings → Environment Variables (nooit in de code of in chat).
# ------------------------------------------------------------
# Uitgaande mailserver zoals Vimexx die toont (bv. mail.zxcs.nl); poort 465 = SSL
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=hello@m7branding.com
SMTP_PASS=

# ------------------------------------------------------------
# Optioneel: Resend (resend.com). Zonder SMTP verstuurt Resend de mail; met RESEND_API_KEY komen
# bevestigde nieuwsbrief-inschrijvingen in Resend (Contacts). Zonder Resend krijgt hello@ per
# bevestigde inschrijving een mail.
# Alleen server-side; zet deze in Vercel → Settings → Environment Variables (nooit in de code of in chat).
# Zonder RESEND_API_KEY vallen de formulieren terug op de webhooks hieronder, en anders op een mailto-knop.
# ------------------------------------------------------------
# API key (Resend → API Keys, rechten: "Full access", want de nieuwsbrief schrijft contacten weg)
RESEND_API_KEY=
# Optioneel. Afzender; m7branding.com moet in Resend geverifieerd zijn (Domains).
MAIL_FROM=M7 Branding <hello@m7branding.com>
# Optioneel. Waar leads (contactformulier + intake) binnenkomen. Komma-gescheiden.
MAIL_TO=hello@m7branding.com
# Optioneel. Waar supporttickets binnenkomen (standaard ook hello@).
SUPPORT_MAIL_TO=hello@m7branding.com
# Optioneel. In cc van de bevestiging aan de klant. Leeg laten = geen cc.
MAIL_CC=martijn@m7branding.com
# Optioneel. Resend → Contacts → Segments: het segment voor de nieuwsbrief (broadcasts stuur je naar dit segment).
RESEND_SEGMENT_ID=
# Optioneel. Geheim voor de bevestigingslinks van de nieuwsbrief (standaard afgeleid van RESEND_API_KEY).
NEWSLETTER_SECRET=

# Optioneel: formulieren óók naar een webhook (Make / n8n / Zapier / Odoo), bv. voor je CRM.
# CONTACT_WEBHOOK_URL ontvangt ook de korte intake (type: "intake").
CONTACT_WEBHOOK_URL=
# Krijgt bevestigde nieuwsbrief-inschrijvingen (na de double opt-in), of zonder Resend elke aanmelding.
NEWSLETTER_WEBHOOK_URL=
# Supporttickets (type: "support"). Leeg = CONTACT_WEBHOOK_URL.
SUPPORT_WEBHOOK_URL=

# Concept-reviews ook in productie tonen (alleen voor previews!)
NEXT_PUBLIC_SHOW_DRAFTS=
